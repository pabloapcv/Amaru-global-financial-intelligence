# Database: SQLite by default. For Postgres/TimescaleDB: pip install -e ".[postgres]" and
# ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
# ATLAS_DATABASE_URL=sqlite:///data/atlas.db
# ATLAS_OBJECT_STORE=data/objects

# LLM orchestration (Claude). Leave unset to use the deterministic engine.
# ANTHROPIC_API_KEY=
# ATLAS_LLM=auto            # auto | off
# ATLAS_LLM_MODEL=claude-opus-5-5
# ATLAS_TONE_MODEL=claude-opus-5-5    # model that reads Fed and ECB statements (default: ATLAS_LLM_MODEL)
# ATLAS_LLM_EFFORT=high     # low | medium | high | xhigh | max
# ATLAS_MAX_TOOL_CALLS=24

# Run the refresh scheduler inside the API process
# ATLAS_SCHEDULER=on
# ATLAS_CORS_ORIGINS=http://localhost:3010

# Accounts (see README)
# ATLAS_AUTH=required         # required | off (off = single-user local mode)
# ATLAS_ALLOW_SIGNUP=true      # self-service sign-up on the login page
# ATLAS_COOKIE_SECURE=false    # set true behind HTTPS
# ATLAS_WEBHOOKS_ALLOW_PRIVATE=false # true lets webhooks reach private addresses and plain http (local testing only)
# ATLAS_PRIVACY_URL=https://example.com/privacy  # optional; linked from public newsletter pages
# ATLAS_OPERATOR_EMAILS=       # comma-separated; these users (with 2FA on) get the Operator console

# Docker compose
# Production overlay (docs/deploy.md): your domain (the API is served at api.<domain>) and the Let's Encrypt contact.
# ATLAS_DOMAIN=atlas.example.com
# ACME_EMAIL=you@example.com
# ATLAS_BACKUP_KEEP=14
# POSTGRES_PASSWORD=change-me
# NEXT_PUBLIC_API_URL=http://localhost:8010

# Monitoring and provider etiquette
# ATLAS_METRICS_TOKEN=        # require Bearer token on /metrics
# Public URL of the API, used in email links such as the weekly digest's unsubscribe link.
# ATLAS_API_PUBLIC_URL=https://api.example.com
# Switch off datasets whose owners restrict redistribution (S&P 500, NASDAQ, VIX).
# ATLAS_COMMERCIAL_MODE=true
# Off-server backups: each daily backup is encrypted here and copied to S3-compatible storage
# (AWS S3, Cloudflare R2, Backblaze B2, MinIO). Path-style URL: https://<endpoint>/<bucket>[/<prefix>].
# The key only needs write (PUT) and read-metadata (HEAD) access; expire old copies with a bucket lifecycle rule.
# Create the encryption key with `atlas backup-key` and keep a copy outside the bucket: without it nothing restores.
# ATLAS_BACKUP_S3_URL=https://s3.us-east-1.amazonaws.com/my-atlas-backups
# ATLAS_BACKUP_S3_REGION=us-east-1   (Cloudflare R2: auto)
# ATLAS_BACKUP_S3_ACCESS_KEY_ID=
# ATLAS_BACKUP_S3_SECRET_ACCESS_KEY=
# ATLAS_BACKUP_ENCRYPTION_KEY=
# Research runs at a time in this process (default 4). 0 = this process only queues research; run `atlas worker` elsewhere.
# ATLAS_RESEARCH_WORKERS=4
# Several API replicas: share rate-limit counts through the database (default: memory, per process).
# ATLAS_RATE_LIMIT_STORE=database
# Encrypts two-factor (TOTP) secrets at rest. Set a long random value in production and keep it stable:
# if it changes, users must sign in with a recovery code and re-enroll. Without it, data/secret.key is created.
# ATLAS_SECRET_KEY=
# Optional: free key from https://fred.stlouisfed.org/docs/api/api_key.html; adds official
# U.S. data release dates to the economic calendar (FOMC dates need no key).
# FRED_API_KEY=
# Optional: free key from https://www.eia.gov/opendata/register.php for weekly U.S. energy inventories.
# Without it the public demo key is used (about ten calls an hour, shared by everyone on your IP).
# EIA_API_KEY=
# ATLAS_USER_AGENT=ATLAS-research/0.1 (+https://your-site.example/contact)

# Email (password reset). Without SMTP, reset links are written to the API log.
# ATLAS_PUBLIC_URL=http://localhost:3010
# ATLAS_SMTP_HOST=smtp.example.com
# ATLAS_SMTP_PORT=587
# ATLAS_SMTP_USER=
# ATLAS_SMTP_PASSWORD=
# ATLAS_SMTP_FROM=ATLAS <no-reply@example.com>

# Reports: native PDF needs `pip install -e ".[pdf]"` plus Pango (included in the Docker image); off disables it
# ATLAS_PDF=auto
# ATLAS_REQUIRE_EMAIL_VERIFICATION=false
# ATLAS_RESEARCH_CACHE_TTL_HOURS=6
