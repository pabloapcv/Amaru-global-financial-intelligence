# Database: SQLite by default. For Postgres/TimescaleDB: pip install -e ".[postgres]" and
# ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
# ATLAS_DATABASE_URL=sqlite:///data/atlas.db
# ATLAS_OBJECT_STORE=data/objects

# LLM orchestration (Claude). Leave unset to use the deterministic engine.
# ANTHROPIC_API_KEY=
# ATLAS_LLM=auto            # auto | off
# ATLAS_LLM_MODEL=claude-opus-5-5
# ATLAS_LLM_EFFORT=high     # low | medium | high | xhigh | max
# ATLAS_MAX_TOOL_CALLS=24

# Run the refresh scheduler inside the API process
# ATLAS_SCHEDULER=on
# ATLAS_CORS_ORIGINS=http://localhost:3010

# Accounts (see README › Accounts)
# ATLAS_AUTH=required         # required | off (off = single-user local mode)
# ATLAS_ALLOW_SIGNUP=true      # self-service sign-up on the login page
# ATLAS_COOKIE_SECURE=false    # set true behind HTTPS

# Docker compose
# POSTGRES_PASSWORD=change-me
# NEXT_PUBLIC_API_URL=http://localhost:8010

# Monitoring and provider etiquette
# ATLAS_METRICS_TOKEN=        # require Bearer token on /metrics
# Public URL of the API, used in email links such as the weekly digest's unsubscribe link.
# ATLAS_API_PUBLIC_URL=https://api.example.com
# Self-service billing (Stripe). Off unless all of these are set. Point a Stripe webhook at
# <API>/api/v1/billing/webhook for checkout.session.completed and customer.subscription.* events.
# STRIPE_SECRET_KEY=sk_live_or_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_INVESTOR=price_...
# STRIPE_PRICE_RESEARCH_PRO=price_...
# STRIPE_PRICE_PRO=price_...
# Commercial deployments: switch off datasets whose owners restrict redistribution (S&P 500, NASDAQ, VIX).
# ATLAS_COMMERCIAL_MODE=true
# Encrypts two-factor (TOTP) secrets at rest. Set a long random value in production and keep it stable:
# if it changes, users must sign in with a recovery code and re-enroll. Without it, data/secret.key is created.
# ATLAS_SECRET_KEY=
# Optional: free key from https://fred.stlouisfed.org/docs/api/api_key.html; adds official
# U.S. data release dates to the economic calendar (FOMC dates need no key).
# FRED_API_KEY=
# ATLAS_USER_AGENT=ATLAS-research/0.1 (+https://your-site.example/contact)

# Email (password reset). Without SMTP, reset links are written to the API log.
# ATLAS_PUBLIC_URL=http://localhost:3010
# ATLAS_SMTP_HOST=smtp.example.com
# ATLAS_SMTP_PORT=587
# ATLAS_SMTP_USER=
# ATLAS_SMTP_PASSWORD=
# ATLAS_SMTP_FROM=ATLAS <no-reply@example.com>

# Reports: native PDF needs `pip install -e ".[pdf]"` plus Pango (included in the Docker image); off disables it
# ATLAS_PDF=auto
# ATLAS_REQUIRE_EMAIL_VERIFICATION=false
# ATLAS_RESEARCH_CACHE_TTL_HOURS=6
